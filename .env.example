# Local development values only. Never use the database password outside local dev.
DATABASE_URL=postgresql://orbital:orbital_local_only@localhost:5432/orbital
# Real PostgreSQL tests use isolated schemas and require this process variable.
TEST_DATABASE_URL=postgresql://orbital:orbital_local_only@localhost:5432/orbital
ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
# Public deployer address only; signing happens in your browser wallet.
ARC_DEPLOYER_ADDRESS=
CHAIN_ID=5042002
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# Set only after a verified deployment manifest exists.
DEPLOYMENT_MANIFEST=
PROOF_MANIFEST=
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_CHAIN_ID=5042002
LOG_LEVEL=info

# pnpm dev:local sets these automatically for its isolated local profile.
# Never enable fixture wallets on a public origin; production builds reject them.
NEXT_PUBLIC_LOCAL_DEMO_WALLET=false
INDEXER_POLL_MS=1000

# pnpm dev:arc uses web 3002 / API 3003, Arc chain 5042002 and real Privy.
# Allow http://127.0.0.1:3002 and http://localhost:3002 in the Privy dashboard.
# No Privy secret, application private key or backend signer is needed.
