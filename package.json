{
  "name": "orbital",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "pnpm --parallel --filter @orbital/web --filter @orbital/api dev",
    "dev:indexer": "pnpm --filter @orbital/indexer dev",
    "local:setup": "node scripts/setup-local.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:arc": "node scripts/dev-arc.mjs",
    "build": "pnpm -r --if-present build",
    "lint": "node scripts/gate.mjs lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:contracts": "forge test --root packages/contracts",
    "test:reference": "python -m unittest discover -s packages/reference/tests -v",
    "test:sdk": "pnpm --filter @orbital/sdk test",
    "test:shared": "pnpm --filter @orbital/shared test",
    "test:backend": "pnpm --filter @orbital/api test",
    "test:database": "pnpm --filter @orbital/db test",
    "test:indexer": "pnpm --filter @orbital/indexer test",
    "test:e2e": "pnpm --filter @orbital/web test:e2e",
    "test:invariants": "node scripts/gate.mjs test:invariants",
    "test:all": "pnpm test:reference && pnpm test:contracts && pnpm test:shared && pnpm test:sdk && pnpm test:database && pnpm test:indexer && pnpm test:backend && pnpm test:e2e",
    "verify:network": "node scripts/verify-network.mjs",
    "deploy:local": "node scripts/local-deployment.mjs persistent",
    "deploy:arc": "node scripts/arc-deployment.mjs",
    "deploy:arc:wallet": "node scripts/arc-wallet-server.mjs",
    "demo:seed": "node packages/sdk/node_modules/tsx/dist/cli.mjs packages/sdk/scripts/local-demo.ts",
    "demo:judge": "node packages/sdk/node_modules/tsx/dist/cli.mjs packages/sdk/scripts/judge-demo.ts",
    "db:migrate": "pnpm --filter @orbital/db migrate",
    "db:replay": "pnpm --filter @orbital/indexer replay",
    "evidence:build": "node scripts/evidence.mjs"
  }
}
